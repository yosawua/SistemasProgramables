# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - PROYECTO BANDA TRANSPORTADORA
# ==============================================================================
# Copia este archivo con el nombre '.env' y completa tus valores reales.
# NUNCA compartas ni subas tu archivo '.env' al repositorio de control de versiones.

# Credenciales de ElevenLabs para síntesis de voz (Text-to-Speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Configuración del Punto de Acceso WiFi (ESP32 SoftAP)
# El SSID identifica la red WiFi generada por el ESP32.
# La contraseña DEBE tener un mínimo de 8 caracteres según el estándar WPA2.
WIFI_AP_SSID=
WIFI_AP_PASSWORD=
